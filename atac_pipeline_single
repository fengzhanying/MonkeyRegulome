fq1=$1
fq2=$2
sample=$3

## QC raw
mkdir $sample;cd $sample
mkdir ./QC_result ./Log/
fastqc -t 20 ${fq1} ${fq2} -o ./QC_result

## Trim Adapter
fastp -i ${fq1} -I ${fq2} -o ${sample}_R1.trimmed.fq.gz -O ${sample}_R2.trimmed.fq.gz --detect_adapter_for_pe --thread 24 --json ./Log/${sample}_fastp.json --html ./Log/${sample}_fastp.html 2> ./Log/${sample}_fastp.log

## QC trim
fastqc -t 20 *.trimmed.fq.gz -o ./QC_result

## Bowtie2
bw2_index="/lustre/home/zhangfy/Pipeline/Bowtie2/Index/Macaca/Macaca"
bowtie2 -p 30 -X 2000 --mm -x $bw2_index -1 ${sample}_R1.trimmed.fq.gz  -2 ${sample}_R2.trimmed.fq.gz -S ${sample}_align.sam --met-file ${sample}_align_result.log &> ./Log/${sample}_align.log
samtools sort ${sample}_align.sam -@ 24 -o ${sample}_align_sorted.bam
samtools index ${sample}_align_sorted.bam
samtools flagstat ${sample}_align_sorted.bam > ./Log/${sample}_align_sorted_stat.log

## rm mito
samtools view -b -L /lustre/home/zhangfy/Pipeline/bin/Macaca.chrom_nomito.bed ${sample}_align_sorted.bam > ${sample}_align_nomito.bam
samtools sort ${sample}_align_nomito.bam -@ 24 -o ${sample}_align_nomito_sorted.bam
samtools index ${sample}_align_nomito_sorted.bam
samtools flagstat ${sample}_align_nomito_sorted.bam > ./Log/${sample}_align_nomito_sorted_stat.log

### rm unmapped lowq reads ${mapq_thresh}=30?
samtools view -F 1804 -f 2 -q 30 -u ${sample}_align_nomito_sorted.bam | samtools sort -n /dev/stdin -o ${sample}_align_nomito_filt.bam
samtools fixmate -r ${sample}_align_nomito_filt.bam ${sample}_align_nomito_filt_fixmate.bam
samtools sort ${sample}_align_nomito_filt_fixmate.bam -@ 20 -o ${sample}_align_nomito_filt_fixmate_sorted.bam
samtools index ${sample}_align_nomito_filt_fixmate_sorted.bam
samtools flagstat ${sample}_align_nomito_filt_fixmate_sorted.bam > ./Log/${sample}_align_nomito_filt_fixmate_sorted_stat.log

## mark dup
java -jar /lustre/home/zhangfy/data0428/picard.jar MarkDuplicates -I ${sample}_align_nomito_filt_fixmate_sorted.bam -O ${sample}_align_nomito_filt_fixmate_markDup.bam -M ./Log/${sample}_align_nomito_filt_fixmate_markDup.log
samtools sort ${sample}_align_nomito_filt_fixmate_markDup.bam -@ 20 -o ${sample}_align_nomito_filt_fixmate_markDup_sorted.bam
samtools index ${sample}_align_nomito_filt_fixmate_markDup_sorted.bam
samtools flagstat ${sample}_align_nomito_filt_fixmate_markDup_sorted.bam > ./Log/${sample}_align_nomito_filt_fixmate_markDup_sorted_stat.log

## rm duplicates
java -jar /lustre/home/zhangfy/data0428/picard.jar MarkDuplicates -I ${sample}_align_nomito_filt_fixmate_sorted.bam -O ${sample}_align_nomito_filt_fixmate_rmDup.bam --REMOVE_DUPLICATES true -M ./Log/${sample}_align_nomito_filt_fixmate_rmDup.log
samtools sort ${sample}_align_nomito_filt_fixmate_rmDup.bam -@ 20 -o ${sample}_align_nomito_filt_fixmate_rmDup_sorted.bam
samtools index ${sample}_align_nomito_filt_fixmate_rmDup_sorted.bam
samtools flagstat ${sample}_align_nomito_filt_fixmate_rmDup_sorted.bam > ./Log/${sample}_align_nomito_filt_fixmate_rmDup_sorted_stat.log

## shift +4/-5
alignmentSieve --numberOfProcessors 20 --ATACshift -b ${sample}_align_nomito_filt_fixmate_rmDup_sorted.bam -o ${sample}_align_nomito_filt_fixmate_rmDup_shifted.bam
samtools sort ${sample}_align_nomito_filt_fixmate_rmDup_shifted.bam -@ 20 -o ${sample}_final.bam
samtools index ${sample}_final.bam
samtools flagstat ${sample}_final.bam > ./Log/${sample}_final.log

### call peak
samtools sort ${sample}_final.bam -n -@ 24 -o ${sample}.bam
bedtools bamtobed -bedpe -mate1 -i ${sample}.bam | gzip -nc > ${sample}.bedpe.gz
zcat -f ${sample}.bedpe.gz | awk 'BEGIN{OFS="\t"}{printf "%s\t%s\t%s\tN\t1000\t%s\n%s\t%s\t%s\tN\t1000\t%s\n",$1,$2,$3,$9,$4,$5,$6,$10}' | gzip -nc > ${sample}.tagAlign.gz
macs2 callpeak -t ${sample}.tagAlign.gz -g 3077605270 -B --keep-dup all --nomodel --shift -100 --extsize 200 -n ${sample} --SPMR

### create fc bw file
mkdir ./BedGraph ./BigWig
macs2 bdgcmp -t ${sample}_treat_pileup.bdg -c ${sample}_control_lambda.bdg --o-prefix ${sample} -m FE
bedtools slop -i ${sample}_FE.bdg -g /lustre/home/zhangfy/Pipeline/bin/Macaca.chrom.sizes -b 0 | bedClip stdin /lustre/home/zhangfy/Pipeline/bin/Macaca.chrom.sizes ./BedGraph/${sample}.fc.signal.bedgraph
sort -k1,1 -k2,2n ${sample}.fc.signal.bedgraph | awk 'BEGIN{OFS="\\t"}{if (NR==1 || NR>1 && (prev_chr!=$1 || prev_chr==$1 && prev_chr_e<=$2)) {print $0}; prev_chr=$1; prev_chr_e=$3;}' > ./BedGraph/${sample}.fc.signal.srt.bedgraph
bedGraphToBigWig ${sample}.fc.signal.srt.bedgraph /lustre/home/zhangfy/Pipeline/bin/Macaca.chrom.sizes ./BigWig/${sample}.fc.signal.bigwig

### create pvalue bw file
sval=`zcat ${sample}.tagAlign.gz | wc -l`
sval=`echo "scale = 2; $sval / 1000000" | bc`
macs2 bdgcmp -t ${sample}_treat_pileup.bdg -c ${sample}_control_lambda.bdg --o-prefix ${sample} -m ppois -S ${sval}
bedtools slop -i ${sample}_ppois.bdg -g /lustre/home/zhangfy/Pipeline/bin/Macaca.chrom.sizes -b 0 | bedClip stdin /lustre/home/zhangfy/Pipeline/bin/Macaca.chrom.sizes ./BedGraph/${sample}.pval.signal.bedgraph
sort -k1,1 -k2,2n ${sample}.pval.signal.bedgraph | awk 'BEGIN{{OFS="\\t"}}{{if (NR==1 || NR>1 && (prev_chr!=$1 || prev_chr==$1 && prev_chr_e<=$2)) {{print $0}}; prev_chr=$1; prev_chr_e=$3;}}' > ./BedGraph/${sample}.pval.signal.srt.bedgraph
bedGraphToBigWig ${sample}.pval.signal.srt.bedgraph /lustre/home/zhangfy/Pipeline/bin/Macaca.chrom.sizes ./BigWig/${sample}.pval.signal.bigwig

## Fragment distribution
mkdir ./InsertSize
conda activate R3.6
java -jar /lustre/home/zhangfy/data0428/picard.jar CollectInsertSizeMetrics -H ./InsertSize/${sample}_InsertSize.pdf -I ${sample}.bam -O ./InsertSize/${sample}_InsertSize.txt
conda deactivate
